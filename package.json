{
  "name": "mediahub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace server",
    "db:validate": "npm run db:validate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "format": "prettier --write client/src client/index.html \"client/*.json\" client/vite.config.ts server/src server/test server/prisma/seed.ts \"server/*.json\" package.json eslint.config.js .github/workflows/ci.yml",
    "format:check": "prettier --check client/src client/index.html \"client/*.json\" client/vite.config.ts server/src server/test server/prisma/seed.ts \"server/*.json\" package.json eslint.config.js .github/workflows/ci.yml"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
