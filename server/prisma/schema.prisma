generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum MediaSection {
  READING
  WATCHING

  @@map("media_section")
}

enum ProgressMode {
  PERCENTAGE
  PAGE
  CHAPTER
  EPISODE

  @@map("progress_mode")
}

enum MetadataOrigin {
  EXTERNAL
  MANUAL

  @@map("metadata_origin")
}

enum ReviewStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED

  @@map("review_status")
}

enum UnitKind {
  SEASON
  EPISODE
  VOLUME
  CHAPTER
  EDITION

  @@map("unit_kind")
}

enum LibraryStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  DROPPED

  @@map("library_status")
}

enum ConnectorKind {
  API
  EXPORT
  SCRAPER

  @@map("connector_kind")
}

enum IngestionKind {
  SELECTED_RESULTS
  PUBLIC_LIST_URL
  FILE_UPLOAD

  @@map("ingestion_kind")
}

enum IngestionStatus {
  QUEUED
  RUNNING
  PREVIEW_READY
  COMPLETED
  FAILED
  CANCELLED

  @@map("ingestion_status")
}

enum ImportAction {
  CREATE
  REUSE
  REVIEW_MATCH
  SKIP

  @@map("import_action")
}

enum ImportDecision {
  UNDECIDED
  CREATE
  REUSE
  SKIP

  @@map("import_decision")
}

enum RecommendationFeedback {
  NONE
  USEFUL
  NOT_INTERESTED
  DISMISSED

  @@map("recommendation_feedback")
}

model Role {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  name  String @unique @db.VarChar(30)
  users User[]

  @@map("roles")
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId          Int              @map("role_id") @db.SmallInt
  googleSubject   String           @unique @map("google_subject") @db.VarChar(255)
  email           String           @unique @db.Citext
  displayName     String           @map("display_name") @db.VarChar(120)
  avatarUrl       String?          @map("avatar_url") @db.Text
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  submittedMedia  MediaItem[]      @relation("MediaItemCreator")
  libraryEntries  LibraryEntry[]
  ingestionJobs   IngestionJob[]
  recommendations Recommendation[]
  auditLogs       AuditLog[]       @relation("AuditActor")

  @@map("users")
}

model UserSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("user_sessions")
}

model MediaType {
  id                  Int                  @id @default(autoincrement()) @db.SmallInt
  code                String               @unique @db.VarChar(20)
  name                String               @unique @db.VarChar(50)
  section             MediaSection
  progressMode        ProgressMode         @map("progress_mode")
  mediaItems          MediaItem[]
  ingestionCandidates IngestionCandidate[]

  @@map("media_types")
}

model MediaItem {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaTypeId         Int                  @map("media_type_id") @db.SmallInt
  title               String               @db.VarChar(300)
  normalizedTitle     String               @map("normalized_title") @db.VarChar(300)
  description         String?              @db.Text
  releaseDate         DateTime?            @map("release_date") @db.Date
  coverUrl            String?              @map("cover_url") @db.Text
  totalUnits          Int?                 @map("total_units")
  origin              MetadataOrigin
  reviewStatus        ReviewStatus         @map("review_status")
  createdByUserId     String?              @map("created_by_user_id") @db.Uuid
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mediaType           MediaType            @relation(fields: [mediaTypeId], references: [id], onDelete: Restrict)
  createdByUser       User?                @relation("MediaItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  genres              MediaGenre[]
  units               MediaUnit[]
  libraryEntries      LibraryEntry[]
  externalMappings    ExternalMapping[]
  ingestionCandidates IngestionCandidate[] @relation("CandidateMatch")
  recommendations     Recommendation[]

  @@index([mediaTypeId, normalizedTitle])
  @@index([reviewStatus, isActive, createdAt(sort: Desc)])
  @@map("media_items")
}

model Genre {
  id         Int          @id @default(autoincrement()) @db.SmallInt
  name       String       @unique @db.VarChar(100)
  slug       String       @unique @db.VarChar(100)
  mediaItems MediaGenre[]

  @@map("genres")
}

model MediaGenre {
  mediaItemId String    @map("media_item_id") @db.Uuid
  genreId     Int       @map("genre_id") @db.SmallInt
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  genre       Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaItemId, genreId])
  @@index([genreId, mediaItemId])
  @@map("media_genres")
}

model MediaUnit {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaItemId     String          @map("media_item_id") @db.Uuid
  parentUnitId    String?         @map("parent_unit_id") @db.Uuid
  unitKind        UnitKind        @map("unit_kind")
  sequenceNumber  Decimal         @map("sequence_number") @db.Decimal(8, 2)
  seasonNumber    Int?            @map("season_number")
  title           String?         @db.VarChar(300)
  durationMinutes Int?            @map("duration_minutes")
  pageCount       Int?            @map("page_count")
  releaseDate     DateTime?       @map("release_date") @db.Date
  mediaItem       MediaItem       @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  parentUnit      MediaUnit?      @relation("MediaUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits      MediaUnit[]     @relation("MediaUnitHierarchy")
  currentIn       LibraryEntry[]  @relation("CurrentLibraryUnit")
  progressEvents  ProgressEvent[]

  @@unique([mediaItemId, unitKind, sequenceNumber])
  @@map("media_units")
}

model LibraryEntry {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  mediaItemId    String          @map("media_item_id") @db.Uuid
  status         LibraryStatus   @default(PLANNED)
  progressValue  Decimal         @default(0) @map("progress_value") @db.Decimal(10, 2)
  currentUnitId  String?         @map("current_unit_id") @db.Uuid
  rating         Decimal?        @db.Decimal(3, 1)
  notes          String?         @db.Text
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem      MediaItem       @relation(fields: [mediaItemId], references: [id], onDelete: Restrict)
  currentUnit    MediaUnit?      @relation("CurrentLibraryUnit", fields: [currentUnitId], references: [id], onDelete: SetNull)
  progressEvents ProgressEvent[]

  @@unique([userId, mediaItemId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("library_entries")
}

model ProgressEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryEntryId String       @map("library_entry_id") @db.Uuid
  unitId         String?      @map("unit_id") @db.Uuid
  oldProgress    Decimal?     @map("old_progress") @db.Decimal(10, 2)
  newProgress    Decimal      @map("new_progress") @db.Decimal(10, 2)
  note           String?      @db.Text
  recordedAt     DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  unit           MediaUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([libraryEntryId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("progress_events")
}

model Source {
  id                  Int                  @id @default(autoincrement()) @db.SmallInt
  key                 String               @unique @db.VarChar(50)
  name                String               @unique @db.VarChar(100)
  connectorKind       ConnectorKind        @map("connector_kind")
  baseUrl             String               @map("base_url") @db.Text
  isEnabled           Boolean              @default(true) @map("is_enabled")
  termsCheckedAt      DateTime             @map("terms_checked_at") @db.Date
  externalMappings    ExternalMapping[]
  ingestionJobs       IngestionJob[]
  ingestionCandidates IngestionCandidate[]

  @@map("sources")
}

model ExternalMapping {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaItemId  String    @map("media_item_id") @db.Uuid
  sourceId     Int       @map("source_id") @db.SmallInt
  externalId   String    @map("external_id") @db.VarChar(255)
  sourceUrl    String    @map("source_url") @db.Text
  contentHash  String?   @map("content_hash") @db.VarChar(128)
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  mediaItem    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([mediaItemId])
  @@map("external_mappings")
}

model IngestionJob {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedByUserId String               @map("requested_by_user_id") @db.Uuid
  sourceId          Int?                 @map("source_id") @db.SmallInt
  kind              IngestionKind
  status            IngestionStatus      @default(QUEUED)
  inputReference    String?              @map("input_reference") @db.VarChar(500)
  candidateCount    Int                  @default(0) @map("candidate_count")
  importedCount     Int                  @default(0) @map("imported_count")
  skippedCount      Int                  @default(0) @map("skipped_count")
  failedCount       Int                  @default(0) @map("failed_count")
  errorCode         String?              @map("error_code") @db.VarChar(80)
  errorMessage      String?              @map("error_message") @db.Text
  requestedAt       DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt         DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(6)
  requestedByUser   User                 @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  source            Source?              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  candidates        IngestionCandidate[]

  @@index([requestedByUserId, status, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("ingestion_jobs")
}

model IngestionCandidate {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String         @map("job_id") @db.Uuid
  sourceId          Int            @map("source_id") @db.SmallInt
  externalId        String         @map("external_id") @db.VarChar(255)
  mediaTypeId       Int            @map("media_type_id") @db.SmallInt
  normalizedPayload Json           @map("normalized_payload") @db.JsonB
  matchMediaId      String?        @map("match_media_id") @db.Uuid
  matchConfidence   Decimal?       @map("match_confidence") @db.Decimal(4, 3)
  proposedAction    ImportAction   @map("proposed_action")
  decision          ImportDecision @default(UNDECIDED)
  validationErrors  Json           @default("[]") @map("validation_errors") @db.JsonB
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  job               IngestionJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source            Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  mediaType         MediaType      @relation(fields: [mediaTypeId], references: [id], onDelete: Restrict)
  matchMedia        MediaItem?     @relation("CandidateMatch", fields: [matchMediaId], references: [id], onDelete: SetNull)

  @@unique([jobId, sourceId, externalId])
  @@index([jobId, decision])
  @@index([matchMediaId])
  @@map("ingestion_candidates")
}

model Recommendation {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  mediaItemId  String                 @map("media_item_id") @db.Uuid
  score        Decimal                @db.Decimal(6, 5)
  modelVersion String                 @map("model_version") @db.VarChar(80)
  reason       String                 @db.Text
  feedback     RecommendationFeedback @default(NONE)
  generatedAt  DateTime               @default(now()) @map("generated_at") @db.Timestamptz(6)
  expiresAt    DateTime?              @map("expires_at") @db.Timestamptz(6)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem    MediaItem              @relation(fields: [mediaItemId], references: [id], onDelete: Restrict)

  @@unique([userId, mediaItemId, modelVersion, generatedAt])
  @@index([userId, score(sort: Desc)])
  @@map("recommendations")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.VarChar(255)
  oldValues   Json?    @map("old_values") @db.JsonB
  newValues   Json?    @map("new_values") @db.JsonB
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
