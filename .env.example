# Application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL container and host connection
POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=mediahub_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mediahub:mediahub_dev_password@localhost:5432/mediahub?schema=public

# Authentication placeholders - configure in Phase 6
SESSION_SECRET=replace-with-a-long-random-development-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# External providers
JIKAN_BASE_URL=https://api.jikan.moe/v4
PROVIDER_REQUEST_TIMEOUT_MS=15000

# Official IMDb API (AWS Data Exchange subscription required)
IMDB_API_KEY=
IMDB_DATA_SET_ID=
IMDB_REVISION_ID=
IMDB_ASSET_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Later provider placeholders
TMDB_API_TOKEN=
GOOGLE_BOOKS_API_KEY=
