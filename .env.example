# Application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5174

# PostgreSQL container and host connection
POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=mediahub_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mediahub:mediahub_dev_password@localhost:5432/mediahub?schema=public

# Authentication and sessions
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_MAX_AGE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# External providers
JIKAN_BASE_URL=https://api.jikan.moe/v4
OMDB_BASE_URL=https://www.omdbapi.com/
OMDB_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_CONTACT_EMAIL=
PROVIDER_REQUEST_TIMEOUT_MS=15000

# Connected-account OAuth clients (configured one provider at a time)
CONNECTION_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-value
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_CALLBACK_URL=http://localhost:3000/api/v1/connections/anilist/callback
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_CALLBACK_URL=http://localhost:3000/api/v1/connections/trakt/callback
GOOGLE_BOOKS_CLIENT_ID=
GOOGLE_BOOKS_CLIENT_SECRET=
GOOGLE_BOOKS_CALLBACK_URL=http://localhost:3000/api/v1/connections/google-books/callback
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_CALLBACK_URL=http://localhost:3000/api/v1/connections/mangadex/callback

# Later provider placeholders
TMDB_API_TOKEN=
GOOGLE_BOOKS_API_KEY=
