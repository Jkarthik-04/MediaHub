# Application
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL container and host connection
POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=mediahub_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mediahub:mediahub_dev_password@localhost:5432/mediahub?schema=public

# Authentication placeholders - configure in Phase 6
SESSION_SECRET=replace-with-a-long-random-development-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# External provider placeholders - configure in Phase 8
TMDB_API_TOKEN=
GOOGLE_BOOKS_API_KEY=
